{
  "name": "@sleepinsummer/agent-browser-cli",
  "version": "0.3.6",
  "description": "Agent-oriented browser sensing and control CLI backed by a native Rust daemon.",
  "license": "MIT",
  "bin": {
    "agent-browser-cli": "npm/bin/agent-browser-cli.js"
  },
  "files": [
    "npm/bin",
    "npm/postinstall.js",
    "assets",
    "docs",
    "runtime",
    "skills",
    "README.md",
    "README_EN.md",
    "AI_INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cargo build --release",
    "playwright:check": "npm --prefix runtime/playwright run check",
    "playwright:install": "npm --prefix runtime/playwright exec playwright install chromium",
    "version": "node scripts/sync-optional-deps.mjs && git add package.json package-lock.json",
    "prepack": "node scripts/sync-optional-deps.mjs",
    "postinstall": "node npm/postinstall.js"
  },
  "dependencies": {
    "@playwright/test": "1.62.0",
    "playwright-core": "1.62.0"
  },
  "optionalDependencies": {
    "@sleepinsummer/agent-browser-cli-darwin-arm64": "0.3.6",
    "@sleepinsummer/agent-browser-cli-darwin-x64": "0.3.6",
    "@sleepinsummer/agent-browser-cli-linux-x64": "0.3.6",
    "@sleepinsummer/agent-browser-cli-linux-arm64": "0.3.6",
    "@sleepinsummer/agent-browser-cli-win32-x64": "0.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sleepinginsummer/agent-browser-cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
